// Prisma schema for DIY Assembly AR Helper

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// User model
model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  clerkId           String    @unique
  name              String?
  role              Role      @default(USER)
  permissions       Json?     // ABAC permissions
  stripeCustomerId  String?   @unique
  subscriptionTier  String?   @default("free")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  manuals           Manual[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

enum Role {
  USER
  PRO
  MANUFACTURER
  ADMIN
}

// Manual model - represents repair/assembly manuals
model Manual {
  id                String   @id @default(cuid())
  userId            String
  brand             String
  model             String
  category          String?
  title             String
  description       String?
  steps             Json     // Array of step objects
  partsRequired     Json?    // Array of parts needed
  toolsRequired     Json?    // Array of tools needed
  estimatedTime     Int?     // Minutes
  difficultyLevel   String?  // easy, medium, hard
  isPublic          Boolean  @default(false)
  isPro             Boolean  @default(false) // Requires Pro subscription
  imageUrls         Json?    // Array of image URLs from R2
  encryptedBlobs    Json?    // Encrypted sensitive data (ciphertext only)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]

  @@index([userId])
  @@index([brand, model])
  @@index([category])
  @@index([isPublic])
  @@map("manuals")
}

// Session model - tracks user progress through a manual
model Session {
  id                String   @id @default(cuid())
  userId            String
  manualId          String
  currentStep       Int      @default(0)
  stepStates        Json     // Array of step completion states
  completedSteps    Int      @default(0)
  totalSteps        Int
  status            SessionStatus @default(IN_PROGRESS)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime @default(now())
  deviceType        String?  // ios, web
  arData            Json?    // AR-specific session data
  telemetry         Json?    // Anonymized telemetry

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manual            Manual   @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([manualId])
  @@index([status])
  @@map("sessions")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
  ABANDONED
}

// Subscription model - tracks user subscriptions
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  stripeSubscriptionId String? @unique
  applePurchaseId   String?  @unique
  tier              String   // free, pro, manufacturer
  status            String   // active, cancelled, past_due
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// Data Subject Rights - for GDPR/privacy compliance
model DataExportRequest {
  id                String   @id @default(cuid())
  userId            String
  requestedAt       DateTime @default(now())
  completedAt       DateTime?
  status            String   // pending, completed, failed
  exportUrl         String?
  expiresAt         DateTime?

  @@index([userId])
  @@index([status])
  @@map("data_export_requests")
}

model DataDeletionRequest {
  id                String   @id @default(cuid())
  userId            String
  requestedAt       DateTime @default(now())
  scheduledFor      DateTime
  completedAt       DateTime?
  status            String   // pending, scheduled, completed

  @@index([userId])
  @@index([status])
  @@map("data_deletion_requests")
}

// Part Detection Cache - for AR part detection
model PartDetectionCache {
  id                String   @id @default(cuid())
  partName          String
  partHash          String   @unique // Hash of part characteristics
  boundingBoxData   Json     // 3D bounding box info
  confidenceScore   Float
  createdAt         DateTime @default(now())

  @@index([partName])
  @@index([partHash])
  @@map("part_detection_cache")
}

// Audit Logs - comprehensive security and compliance logging
model AuditLog {
  id                String   @id @default(cuid())
  eventType         String   // Type of event (auth.login, payment.succeeded, etc.)
  severity          String   // info, warning, error, critical
  userId            String?
  resourceType      String?  // Type of resource (manual, session, user, etc.)
  resourceId        String?  // ID of the affected resource
  action            String   // Action performed
  description       String?  // Human-readable description
  metadata          Json?    // Additional context data
  ipAddress         String?
  userAgent         String?
  success           Boolean
  timestamp         DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@index([severity])
  @@map("audit_logs")
}

// API Keys - for manufacturer integrations
model APIKey {
  id                String   @id @default(cuid())
  userId            String
  name              String   // Friendly name for the key
  keyHash           String   @unique // SHA-256 hash of the key
  prefix            String   // First 8 chars for identification
  scopes            Json     // Array of permitted scopes
  rateLimit         Int      @default(1000) // Requests per hour
  lastUsedAt        DateTime?
  expiresAt         DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
  @@map("api_keys")
}

// Notifications - for email and push notifications
model Notification {
  id                String   @id @default(cuid())
  userId            String
  type              String   // email, push, in_app
  category          String   // manual_update, subscription, system, etc.
  title             String
  message           String
  data              Json?    // Additional data
  read              Boolean  @default(false)
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// Email Queue - for reliable email delivery
model EmailQueue {
  id                String   @id @default(cuid())
  to                String
  from              String
  subject           String
  html              String
  text              String?
  template          String?  // Template name
  templateData      Json?    // Template variables
  status            String   // pending, sent, failed
  attempts          Int      @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  error             String?
  createdAt         DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("email_queue")
}

// File Uploads - track uploaded files
model FileUpload {
  id                String   @id @default(cuid())
  userId            String
  filename          String
  originalFilename  String
  mimeType          String
  size              Int      // Bytes
  path              String   // R2 path
  url               String   // Public URL
  bucket            String   // R2 bucket name
  checksum          String   // SHA-256 checksum
  isEncrypted       Boolean  @default(false)
  metadata          Json?    // Additional metadata (dimensions, duration, etc.)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([checksum])
  @@map("file_uploads")
}

// Manual Reviews - user reviews for manuals
model ManualReview {
  id                String   @id @default(cuid())
  manualId          String
  userId            String
  rating            Int      // 1-5
  title             String?
  comment           String?
  helpful           Int      @default(0) // Helpful votes
  notHelpful        Int      @default(0) // Not helpful votes
  isVerified        Boolean  @default(false) // Verified purchase/completion
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([manualId])
  @@index([userId])
  @@index([rating])
  @@map("manual_reviews")
}

// Favorites/Bookmarks - user saved manuals
model Favorite {
  id                String   @id @default(cuid())
  userId            String
  manualId          String
  createdAt         DateTime @default(now())

  @@unique([userId, manualId])
  @@index([userId])
  @@index([manualId])
  @@map("favorites")
}

// Search Analytics - track searches for improvement
model SearchAnalytics {
  id                String   @id @default(cuid())
  userId            String?
  query             String
  resultsCount      Int
  selectedResultId  String?  // Manual ID if clicked
  createdAt         DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_analytics")
}

// Feature Flags - for gradual rollouts
model FeatureFlag {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0) // 0-100
  conditions        Json?    // Conditional logic
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}
