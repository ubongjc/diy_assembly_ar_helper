# Database
DATABASE_URL="postgresql://user:password@localhost:5432/diy_ar_helper?schema=public"

# Clerk Authentication (Passkey/WebAuthn support)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx # For webhook signature verification
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx # Pro plan price ID
STRIPE_MANUFACTURER_PRICE_ID=price_xxxxx # Manufacturer plan price ID

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=xxxxx
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx
R2_BUCKET_NAME=diy-ar-helper
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com

# Sentry (Error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_AUTH_TOKEN=xxxxx
SENTRY_ORG=xxxxx
SENTRY_PROJECT=xxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=diy-ar-helper-web

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Encryption (for client-side encryption key derivation)
ENCRYPTION_MASTER_KEY=xxxxx # Used server-side for key derivation only

# Feature Flags
NEXT_PUBLIC_ENABLE_AR_FEATURES=true
NEXT_PUBLIC_ENABLE_OFFLINE_PACKS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# iOS App Configuration (for API access)
IOS_APP_BUNDLE_ID=com.diyarhelper.ios
IOS_SHARED_SECRET=xxxxx # For StoreKit receipt validation

# Upstash Redis (for rate limiting - optional for development)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
